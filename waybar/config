{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "hyprland/language",
        "network",
        "pulseaudio",
        "pulseaudio/slider",
        "idle_inhibitor",
        "tray",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": true,
        "tooltip-format": "Apps · Super + Space\nRight click: browse apps\nMiddle click: themes",
        "on-click": "~/.local/bin/app-launcher.sh",
        "on-click-right": "~/.local/bin/app-launcher.sh browse",
        "on-click-middle": "~/.local/bin/desktop-theme.py"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": false,
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "separate-outputs": true,
        "tooltip": false
    },
    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "tooltip-format": "CPU: {usage}%\nLoad: {load}\nClick for system monitor",
        "on-click": "ghostty -e btop"
    },
    "memory": {
        "interval": 5,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB\nAvailable: {avail:0.1f} GiB",
        "on-click": "ghostty -e btop"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-el": "GR",
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout all next"
    },
    "network": {
        "interval": 5,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Network disconnected",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nClick: audio settings · Right click: mute"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Keep awake: on",
        "tooltip-format-deactivated": "Keep awake: off"
    },
    "tray": {
        "spacing": 10,
        "icon-size": 15
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Power menu · Super + X",
        "on-click": "~/.local/bin/power-menu.sh"
    }
}
